{
  "manifest_version": 3,
  "name": "ME Instagram Reel Bridge",
  "version": "1.1.7",
  "description": "로그인된 Chrome에서 벤치마킹 Instagram Reels를 수집해 ME 서버로 전달합니다.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [
    {
      "matches": ["https://*.up.railway.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {"default_popup": "popup.html", "default_title": "ME Instagram Reel Bridge"}
}
